<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutOfflineContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_offline"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <!-- Animated Radar Container -->
        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginBottom="28dp">

            <!-- Outer Pulse Ripple Ring -->
            <View
                android:id="@+id/viewOfflineRipple"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_offline_circle"
                android:alpha="0.4" />

            <!-- Inner Circle with Icon -->
            <FrameLayout
                android:id="@+id/viewOfflineCenterCircle"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_offline_circle">

                <ImageView
                    android:id="@+id/imgOfflineRadar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/offline_title"
                    android:src="@drawable/ic_offline_radar" />
            </FrameLayout>
        </FrameLayout>

        <!-- Offline Title -->
        <TextView
            android:id="@+id/tvOfflineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/offline_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Offline Subtitle (Never reveals shop URL or web errors) -->
        <TextView
            android:id="@+id/tvOfflineSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/offline_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Retry Button -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnRetryOffline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_retry_btn"
                android:gravity="center"
                android:minWidth="180dp"
                android:paddingHorizontal="32dp"
                android:paddingVertical="14dp"
                android:text="@string/btn_retry"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressOfflineRetry"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/text_white"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

</RelativeLayout>
